+                 (s_gpr[rs].sc - (double)(int32_t)base_val) * 0.5;
+    double idx_int = (double)((a - s_recip.base) >> 1);
+    /* the entry must be what the table formula says, and the exact index must
+     * be the one the guest's truncations arrived at */
+    if (idx_int < 1.0 || std::fabs(s_recip.numerator / idx_int - (double)value) > 1.0) return 0;
