+/* `instr` is the load; its base register must carry the exact index. */
+static inline int recip_scalar(uint32_t instr, uint32_t addr, uint32_t value, double *out) {
+    if (!s_recip.count) return 0;
+    uint32_t a = addr & 0x1FFFFFu;
+    if (a < s_recip.base || a >= s_recip.base + 2u * s_recip.count || ((a - s_recip.base) & 1u))
+        return 0;
