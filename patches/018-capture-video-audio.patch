     int16_t cd_vol_r = cd_input_volume(spu_regs[reg_index(0x1F801DB2u)]);
+    if (s_capture_no_cd) { cd_vol_l = 0; cd_vol_r = 0; }
     uint32_t eon = (uint32_t)spu_regs[reg_index(0x1F801D98u)]
                  | ((uint32_t)spu_regs[reg_index(0x1F801D9Au)] << 16);
 
@@ -1165,6 +1199,10 @@ void spu_render(int16_t* out_stereo, int frames) {
                         t->vol_r = (int16_t)(vr >> 1);
                     }
                     if (!s) continue;
+                    if (s_capture_mute_hi) {
+                        uint32_t start = (uint32_t)voice_reg(v, 3) << 3;
+                        if (start >= s_capture_mute_lo && start < s_capture_mute_hi) continue;
+                    }
                     int32_t cl = ((int32_t)s * vl) >> 15;
                     int32_t cr = ((int32_t)s * vr) >> 15;
                     voice_l += cl;
@@ -1310,6 +1348,15 @@ void spu_render(int16_t* out_stereo, int frames) {
      * (post-shadow, pre host fade/mute). Placed here so every spu_render
      * caller — the vblank pump and the turbo fade tail — is covered. */
     audio_trace_pcm(AUDIO_TAP_SPU_OUT, out_stereo, frames);
+
+    if (s_capture_file && s_capture_armed) {
+        if (fwrite(out_stereo, sizeof(int16_t) * 2u, (size_t)frames, s_capture_file) != (size_t)frames) {
+            fclose(s_capture_file);   /* disk full or gone: stop recording, keep playing */
+            s_capture_file = NULL;
+        } else {
+            fflush(s_capture_file);
+        }
+    }
 }
 
