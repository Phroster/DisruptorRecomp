+/* PSX_GL_FRAME_PIPE: stream the presented picture, as raw RGB24 rows top row
+ * first, to the stdin of the given command (for example an ffmpeg encoder), to
+ * record gameplay video: one video frame per guest frame (VBlank). A picture
+ * is written once the next present shows how many guest frames it stayed on
+ * screen, so 30 fps scenes keep their real speed. "{w}" and "{h}" in the
+ * command become the size of the first frame; frames of any other size are
+ * skipped. The frame pacer never drops frames when it falls behind, so a slow
+ * encoder slows the game down instead of losing frames. Arms PSX_SPU_CAPTURE
+ * on the first frame. Off unless the variable is set. */
+static void gl_frame_pipe_write(void) {
+    extern void spu_capture_arm(void);
+    static int s_pipe_init = 0, s_pipe_w = 0, s_pipe_h = 0, s_pipe_have = 0;
+    static uint64_t s_pipe_frame = 0;
+    static FILE *s_pipe = NULL;
+    static uint8_t *s_pipe_rows = NULL, *s_pipe_prev = NULL;
+    if (s_pipe_init && !s_pipe) return;
+    int ww = 0, wh = 0;
+    SDL_GL_GetDrawableSize(s_win, &ww, &wh);
+    if (ww <= 0 || wh <= 0) return;
+    if (!s_pipe_init) {
+        const char *tmpl = getenv("PSX_GL_FRAME_PIPE");
+        char cmd[4096];
+        size_t n = 0;
+        s_pipe_init = 1;
+        if (!tmpl || !*tmpl) return;
+        for (const char *t = tmpl; *t && n + 16 < sizeof(cmd); ) {
+            if (!strncmp(t, "{w}", 3)) { n += (size_t)snprintf(cmd + n, sizeof(cmd) - n, "%d", ww); t += 3; }
+            else if (!strncmp(t, "{h}", 3)) { n += (size_t)snprintf(cmd + n, sizeof(cmd) - n, "%d", wh); t += 3; }
+            else cmd[n++] = *t++;
+        }
+        cmd[n] = '\0';
+        s_pipe_rows = (uint8_t *)malloc((size_t)ww * wh * 3);
+        s_pipe_prev = (uint8_t *)malloc((size_t)ww * wh * 3);
+#ifdef _WIN32
+        s_pipe = (s_pipe_rows && s_pipe_prev) ? _popen(cmd, "wb") : NULL;
+#else
+        s_pipe = (s_pipe_rows && s_pipe_prev) ? popen(cmd, "w") : NULL;
+#endif
+        if (!s_pipe) {
+            free(s_pipe_rows); free(s_pipe_prev);
+            s_pipe_rows = s_pipe_prev = NULL;
+            return;
+        }
+        s_pipe_w = ww;
+        s_pipe_h = wh;
+        spu_capture_arm();
+    }
+    if (ww != s_pipe_w || wh != s_pipe_h) return;
+    const size_t size = (size_t)ww * wh * 3;
+    if (s_pipe_have) {
+        uint64_t held = s_frame_count - s_pipe_frame;
+        int repeat = held < 1 ? 1 : held > 8 ? 8 : (int)held;
+        for (int i = 0; i < repeat && s_pipe; i++) {
+            if (fwrite(s_pipe_prev, 1, size, s_pipe) != size) {
+                /* The consumer went away: stop recording, keep playing. */
+#ifdef _WIN32
+                _pclose(s_pipe);
+#else
+                pclose(s_pipe);
+#endif
+                s_pipe = NULL;
+            }
+        }
+        if (!s_pipe) return;
+    }
+    glPixelStorei(GL_PACK_ALIGNMENT, 1);
+    glReadPixels(0, 0, ww, wh, GL_RGB, GL_UNSIGNED_BYTE, s_pipe_rows);
+    for (int y = 0; y < wh; y++)
+        memcpy(s_pipe_prev + (size_t)y * ww * 3, s_pipe_rows + (size_t)(wh - 1 - y) * ww * 3, (size_t)ww * 3);
+    s_pipe_frame = s_frame_count;
+    s_pipe_have = 1;
+}
