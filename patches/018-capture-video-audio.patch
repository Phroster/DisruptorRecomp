+/* PSX_SPU_CAPTURE=<file>: write the sound chip's output as raw 16-bit stereo
+ * PCM at 44100 Hz on the guest clock (one sample per 768 guest cycles), to
+ * record gameplay video together with PSX_GL_FRAME_PIPE. Writing starts when
+ * the video recorder takes its first frame (spu_capture_arm), so both streams
+ * start on the same guest frame. PSX_SPU_CAPTURE_NO_CD=1 mutes the CD audio
+ * input (streamed XA / CD-DA: music and movie sound).
+ * PSX_SPU_CAPTURE_MUTE_RANGE=<lo>-<hi> (hex byte addresses in sound RAM) leaves
+ * out every voice whose sample starts in [lo, hi), for games that play their
+ * music from sound RAM (the voices keep running; only their output is
+ * dropped). Off unless set. */
+static FILE *s_capture_file;
+static int s_capture_init, s_capture_armed, s_capture_no_cd;
+static uint32_t s_capture_mute_lo, s_capture_mute_hi;
+
+static void spu_capture_setup(void) {
+    const char *path, *no_cd;
+    if (s_capture_init) return;
+    s_capture_init = 1;
+    no_cd = getenv("PSX_SPU_CAPTURE_NO_CD");
+    s_capture_no_cd = no_cd && no_cd[0] == '1';
+    const char *range = getenv("PSX_SPU_CAPTURE_MUTE_RANGE");
+    if (range && *range) {
+        char *end = NULL;
+        s_capture_mute_lo = (uint32_t)strtoul(range, &end, 16);
+        if (end && *end == '-') s_capture_mute_hi = (uint32_t)strtoul(end + 1, NULL, 16);
+    }
+    path = getenv("PSX_SPU_CAPTURE");
+    if (path && *path) s_capture_file = fopen(path, "wb");
+}
+
+void spu_capture_arm(void) { s_capture_armed = 1; }
