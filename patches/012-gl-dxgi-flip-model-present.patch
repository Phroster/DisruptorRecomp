+/* Deferred frame pacing (DXGI present path). Everything the present does
+ * before the flip - compose, OSD, the GL->D3D blit and copy - takes a variable
+ * 1-3.5 ms. When that ran AFTER the pacer released the frame, the variation
+ * landed on the photon time (measured: 429 of 957 off-cadence frames). With
+ * the flag set the presenter calls psx_present_deferred_pace() immediately
+ * before Present(), so only a constant-time call follows the wait, and the GPU
+ * gets the wait as a head start on the frame. The guard runs the wait on the
+ * paths that return without presenting, so the guest can never free-run. */
+static int s_present_pace_deferred = 0;
+extern "C" void psx_present_deferred_pace(void) {
+    if (!s_present_pace_deferred) return;
+    s_present_pace_deferred = 0;
+    uint64_t perf_start = runtime_perf_section_begin();
+    frame_pacer_wait(&s_frame_pacer, g_frame_period_ms);
+    runtime_perf_section_end(perf_start, &g_runtime_perf.pacer_ticks);
+    latency_ring_mark(LAT_PACED);
+}
+struct DeferredPaceGuard { ~DeferredPaceGuard() { psx_present_deferred_pace(); } };
+
 static void runtime_perf_diag_tick() {
     static bool have_last = false;
     static RuntimePerfSnapshot last;
@@ -6568,6 +6588,7 @@ static NetplayVblankEpilogue sdl_vblank_present_body(void) {
