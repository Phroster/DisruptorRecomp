+
+#include <stdint.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+struct SDL_Window;
+
+/* After the GL context is current. Returns 1 when the DXGI path is active. */
+int gl_dxgi_present_init(struct SDL_Window *win);
+/* Present GL framebuffer 0 (w x h drawable pixels). swap_interval: 0 =
+ * immediate (tearing/VRR allowed), N = sync to every Nth vblank. Returns 1 if
+ * the frame was presented here; 0 means the caller must do the GL swap. */
+int gl_dxgi_present_frame(int w, int h, int swap_interval);
+void gl_dxgi_present_shutdown(void);
+int gl_dxgi_present_active(void);
+uint64_t gl_dxgi_present_frames(void);
+
+#ifdef __cplusplus
+}
+#endif
+#endif
