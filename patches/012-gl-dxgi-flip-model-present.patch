+/* gl_dxgi_present.h - DXGI flip-model presentation for the OpenGL renderer
+ * (Windows). See gl_dxgi_present.c. All functions are no-ops returning 0 on
+ * other platforms. Call from the thread that owns the GL context. */
+#ifndef GL_DXGI_PRESENT_H
