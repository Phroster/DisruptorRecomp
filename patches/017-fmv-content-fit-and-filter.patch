+/* Presentation overrides apply only to actual RGB888 movie frames, never to
+ * the forced-CPU diagnostic or the 15-bit menus. The game's launcher supplies
+ * the encoded content size; no brightness-based crop (dark scenes must not zoom).
+ * All Disruptor STR headers are 320x180; the player centres them in 320x240. */
+static int fmv_content_height(int src_w, int src_h) {
+    static int checked = 0, width = 0, height = 0;
+    if (!checked) {
+        const char *e = getenv("PSX_GL_FMV_CONTENT");
+        char trailing;
+        checked = 1;
+        if (!e || sscanf(e, "%dx%d%c", &width, &height, &trailing) != 2 ||
+            width <= 0 || width > VRAM_W || height <= 0 || height > VRAM_H) {
+            width = height = 0;
+        }
+    }
+    return width == src_w && height > 0 && height <= src_h ? height : 0;
+}
+
 static int fmv_filter_mode(void) {
-    return s_fmv_filter_cfg - 1;
+    static int override = -2;
+    if (override == -2) {
+        const char *e = getenv("PSX_GL_FMV_FILTER");
+        override = -3;  /* no override: use settings.toml */
+        if (e) {
+            if (!strcmp(e, "nearest")) override = -1;
+            else if (!strcmp(e, "bilinear")) override = 0;
+            else if (!strcmp(e, "sharp")) override = 1;
+            else if (!strcmp(e, "bicubic")) override = 2;
+        }
+    }
+    return override >= -1 ? override : s_fmv_filter_cfg - 1;
 }

