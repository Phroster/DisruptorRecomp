+/* Seam census (diagnostic, off unless armed over TCP "seam_dump"): every
+ * triangle vertex of a guest frame with the position the renderer will use
+ * (16.16, draw offset applied) and where it came from. Two vertices that land
+ * within a pixel of each other without being bit-identical are a crack between
+ * polygons; the provenance pair says which path produced it. */
+#define SEAM_CENSUS_MAX 16384u
+typedef struct { int32_t x16, y16; uint32_t addr; uint32_t word; uint8_t src; uint8_t prim; } SeamVert;
+static SeamVert s_seam_cur[SEAM_CENSUS_MAX], s_seam_done[SEAM_CENSUS_MAX];
+static uint32_t s_seam_cur_n, s_seam_done_n, s_seam_done_frame;
+static uint32_t s_seam_frame = (uint32_t)-1;
+static int      s_seam_armed;
+
+static void seam_census_note(int32_t x16, int32_t y16, uint32_t addr, uint32_t word, int src) {
+    /* A guest frame is one render pass: from one screen clear (GP0 fill) to the
+     * next. The VBlank counter splits passes that straddle a VBlank. */
+    uint32_t f = (uint32_t)gp0_fill_count;
+    if (f != s_seam_frame) {
+        memcpy(s_seam_done, s_seam_cur, s_seam_cur_n * sizeof(SeamVert));
+        s_seam_done_n = s_seam_cur_n;
+        s_seam_done_frame = s_seam_frame;
+        s_seam_cur_n = 0;
+        s_seam_frame = f;
+    }
+    if (s_seam_cur_n < SEAM_CENSUS_MAX) {
+        SeamVert *v = &s_seam_cur[s_seam_cur_n++];
+        v->x16 = x16; v->y16 = y16; v->addr = addr; v->word = word;
+        v->src = (uint8_t)src; v->prim = (uint8_t)(gp0_cmd_buf[0] >> 24);
+    }
+}
+
+/* Arms the census and writes the last completed frame as CSV. Returns the
+ * number of vertices written, or -1 if the file could not be opened. */
+int gpu_seam_census_dump(const char *path) {
+    s_seam_armed = 1;
+    FILE *f = fopen(path, "wb");
+    if (!f) return -1;
+    fprintf(f, "frame,x16,y16,src,prim,addr,word\n");
+    for (uint32_t i = 0; i < s_seam_done_n; i++) {
+        const SeamVert *v = &s_seam_done[i];
+        fprintf(f, "%u,%d,%d,%u,%u,%08X,%08X\n", (unsigned)s_seam_done_frame,
+                (int)v->x16, (int)v->y16, (unsigned)v->src, (unsigned)v->prim,
+                (unsigned)v->addr, (unsigned)v->word);
+    }
+    fclose(f);
+    return (int)s_seam_done_n;
+}
