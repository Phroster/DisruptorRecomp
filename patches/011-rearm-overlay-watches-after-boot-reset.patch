 #endif
 }
 
+/* memory_init() runs AFTER overlay_loader_init() and its
+ * dirty_ram_reset_for_boot() wipes the overlay watch bitmap and page
+ * generations that scan_cache_dir() armed for every indexed manifest. With the
+ * watches gone, guest writes to a manifested page neither bump its generation
+ * nor invalidate the final-miss cache, so a manifest function first judged
+ * ENTRY_INVALID (e.g. a kernel install slot checked before the guest's patcher
+ * finished) keeps that verdict forever and its bundle never loads: the code
+ * interprets for the life of the process although a byte-exact shard is
+ * cached. Re-arm every watch and drop all host-side validation memos. */
+void overlay_loader_rearm_after_boot_reset(void)
+{
+    if (!s_active) return;
+    for (int li = 0; li < s_lazy_man_n; li++) {
+        LazyMan *lm = &s_lazy_man[li];
+        for (int r = 0; r < lm->fn.n; r++)
+            overlay_watch_set_range(lm->fn.lo[r] & 0x1FFFFFFFu, lm->fn.len[r]);
+        lm->val_gen = 0;
+        lm->state = 0xFFu;
+    }
+    for (int i = 0; i < s_cand_n; i++) {
+        Candidate *c = &s_cand[i];
+        for (int r = 0; r < c->nranges; r++)
+            overlay_watch_set_range(c->range_lo[r], c->range_len[r]);
+    }
+    overlay_loader_resync_validation_after_restore();
+    overlay_loader_clear_lazy_miss();
+}
