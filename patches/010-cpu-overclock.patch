+/* Guest CPU overclock (see psx_cycles.h). */
+uint32_t psx_cpu_oc_percent = 100u;
+uint64_t psx_cpu_oc_rem = 0u;
+
+void psx_cpu_overclock_env_init(void) {
+    const char *e = getenv("PSX_CPU_OVERCLOCK");
+    long v;
+    if (!e || !e[0]) return;
+    v = atol(e);
+    if (v < 100 || v > 400) {
+        fprintf(stdout, "psxrecomp: PSX_CPU_OVERCLOCK=%s ignored (use 100..400)\n", e);
+        return;
+    }
+    psx_cpu_oc_percent = (uint32_t)v;
+    psx_cpu_oc_rem = 0u;
+    if (v != 100)
+        fprintf(stdout, "psxrecomp: guest CPU overclock %ld%% (%.1f MHz equivalent)\n",
+                v, 33.8688 * (double)v / 100.0);
+}
