 /* Advance guest time. Overlay DLLs forward this through their callback shim;
  * normal runtime/generated code keeps the common production path inlined. */
+/* Guest CPU overclock (percent, 100 = stock 33.8688 MHz). CPU work charged
+ * through psx_advance_cycles() is scaled by 100/percent before it reaches the
+ * guest clock, so the CPU retires percent/100 as many instructions per VBlank
+ * while every device (VBlank, timers, SPU sample rate, CD) keeps stock time.
+ * A 30 fps engine forced to draw every VBlank (a 60 fps mod) needs this when
+ * its frame does not fit in one stock VBlank of CPU time. Absolute waits
+ * (stalls to a GTE/muldiv completion stamp, idle skips, load acceleration)
+ * use psx_advance_cycles_raw() and are never scaled. The remainder carries
+ * so long-run totals are exact. PSX_CPU_OVERCLOCK=<100..400> in the env. */
+extern uint32_t psx_cpu_oc_percent;   /* 100 = off */
+extern uint64_t psx_cpu_oc_rem;
+static inline uint32_t psx_cpu_oc_scale(uint32_t cycles) {
+    uint64_t t;
+    if (psx_cpu_oc_percent == 100u) return cycles;
+    t = (uint64_t)cycles * 100u + psx_cpu_oc_rem;
+    psx_cpu_oc_rem = t % psx_cpu_oc_percent;
+    return (uint32_t)(t / psx_cpu_oc_percent);
+}
