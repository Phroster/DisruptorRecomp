+/* Candidate space for dispatch: the kernel/overlay windows, plus any PC whose
+ * live bytes match a captured manifest entry. The second clause admits clean
+ * static misses — game-text PCs the compiled dispatch table has no entry for
+ * (computed jumps into function interiors, packed self-overlays): the
+ * interpreter is already executing those live RAM bytes, so a byte-guarded
+ * captured shard can only replace interpreter work, never static-native work.
+ * The shard's own per-dispatch CRC guard still rejects stale code, and a
+ * failed load is memoized in the lazy miss cache. */
+static int loader_candidate_space(uint32_t phys) {
+    return overlay_cache_window_contains(phys) || lazy_has_exact_entry(phys);
+}
