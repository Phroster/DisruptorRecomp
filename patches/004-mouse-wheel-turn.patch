+/* Wheel and relative-motion pseudo-scancodes, above the mouse-button block. */
+#define PSXKB_WHEELUP_SC    ((SDL_Scancode)520)
+#define PSXKB_WHEELDOWN_SC  ((SDL_Scancode)521)
+#define PSXKB_MOUSEX_NEG_SC ((SDL_Scancode)522)   /* mouse moved left  */
+#define PSXKB_MOUSEX_POS_SC ((SDL_Scancode)523)   /* mouse moved right */
+
+/* Relative-mouse turn tuning, in pixels per guest frame (~60 Hz). Motion is
+ * accumulated; the turn asserts as soon as motion is seen (small start/hold
+ * thresholds keep it responsive) and a modest decay releases it within a frame
+ * or two of the mouse stopping, so the view does not keep drifting. */
+#define PSXKB_TURN_START_PX 1.0f
+#define PSXKB_TURN_HOLD_PX  0.2f
+#define PSXKB_TURN_DECAY_PX 1.0f
+#define PSXKB_TURN_MAX_PX   4.0f
+#define PSXKB_WHEEL_PULSE   4
+
+static int   s_wheel_up = 0, s_wheel_down = 0;
+/* Written by the event loop, read by the game thread: atomics. */
+static int   s_wheel_claimed = 0, s_wheel_notches = 0;
+static uint16_t s_mod_press = 0, s_mod_release = 0;
+static uint8_t  s_debug_keys[SDL_NUM_SCANCODES];
+static float s_mouse_dx = 0.0f;
+static float s_mouse_dy = 0.0f;
+static float s_turn_accum = 0.0f;
+static int   s_turn_state = 0;   /* -1 left, +1 right, 0 none */
+
+void psx_keybinds_mouse_wheel(int dy) {
+    if (__atomic_load_n(&s_wheel_claimed, __ATOMIC_RELAXED)) {
+        __atomic_add_fetch(&s_wheel_notches, dy, __ATOMIC_RELAXED);
+        return;
+    }
+    if (dy > 0)      s_wheel_up = PSXKB_WHEEL_PULSE;
+    else if (dy < 0) s_wheel_down = PSXKB_WHEEL_PULSE;
+}
+
+void psx_keybinds_claim_wheel(int claimed) {
+    __atomic_store_n(&s_wheel_claimed, claimed ? 1 : 0, __ATOMIC_RELAXED);
+    if (claimed) s_wheel_up = s_wheel_down = 0;
+}
+
+int psx_keybinds_take_wheel_notches(void) {
+    return __atomic_exchange_n(&s_wheel_notches, 0, __ATOMIC_RELAXED);
+}
+
+void psx_keybinds_set_mod_buttons(uint16_t press, uint16_t release) {
+    s_mod_press = press;
+    s_mod_release = release;
+}
+
+void psx_keybinds_debug_key(int scancode, int down) {
+    if (scancode > 0 && scancode < SDL_NUM_SCANCODES)
+        s_debug_keys[scancode] = down ? 1u : 0u;
+}
+
+void psx_keybinds_mouse_motion(float dx) { s_mouse_dx += dx; }
+void psx_keybinds_mouse_motion_y(float dy) { s_mouse_dy += dy; }
+
+float psx_keybinds_take_mouse_dx(void) {
+    const float dx = s_mouse_dx;
+    s_mouse_dx = 0.0f;
+    return dx;
+}
+
+float psx_keybinds_take_mouse_dy(void) {
+    const float dy = s_mouse_dy;
+    s_mouse_dy = 0.0f;
+    return dy;
+}
+
+void psx_keybinds_frame_tick(void) {
+    if (s_wheel_up > 0)   s_wheel_up--;
+    if (s_wheel_down > 0) s_wheel_down--;
+    s_turn_accum += s_mouse_dx;
+    s_mouse_dx = 0.0f;
+    if (s_turn_accum > PSXKB_TURN_MAX_PX)  s_turn_accum = PSXKB_TURN_MAX_PX;
+    if (s_turn_accum < -PSXKB_TURN_MAX_PX) s_turn_accum = -PSXKB_TURN_MAX_PX;
+    const float start = s_turn_state ? PSXKB_TURN_HOLD_PX : PSXKB_TURN_START_PX;
+    if (s_turn_accum >= start) {
+        s_turn_state = 1;
+        s_turn_accum -= PSXKB_TURN_DECAY_PX;
+        if (s_turn_accum < 0.0f) s_turn_accum = 0.0f;
+    } else if (s_turn_accum <= -start) {
+        s_turn_state = -1;
+        s_turn_accum += PSXKB_TURN_DECAY_PX;
+        if (s_turn_accum > 0.0f) s_turn_accum = 0.0f;
+    } else {
+        s_turn_state = 0;
+        if (s_turn_accum > -0.5f && s_turn_accum < 0.5f) s_turn_accum = 0.0f;
+    }
+}
