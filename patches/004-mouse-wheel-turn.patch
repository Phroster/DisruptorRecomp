+/* Host mouse feed for the keybind layer's wheel / relative-turn pseudo-bindings.
+ * Registered with SDL_AddEventWatch so it sees events regardless of which of the
+ * runtime's several SDL_PollEvent loops consumes them. Relative mouse mode is
+ * toggled with window focus: captured while the game window is active (mouse
+ * turning + wheel), released when it is not so the desktop cursor works. */
+static int psx_host_mouse_capture = 0;
+#if defined(PSX_SDL3)
+static bool SDLCALL psx_host_input_watch(void* userdata, SDL_Event* ev) {
+#else
+static int SDLCALL psx_host_input_watch(void* userdata, SDL_Event* ev) {
+#endif
+    (void)userdata;
+#if defined(PSX_SDL3)
+    switch (ev->type) {
+    case SDL_EVENT_MOUSE_WHEEL:
+        psx_keybinds_mouse_wheel((int)ev->wheel.y);
+        break;
+    case SDL_EVENT_MOUSE_MOTION:
+        if (psx_host_mouse_capture) {
+            psx_keybinds_mouse_motion(ev->motion.xrel);
+            psx_keybinds_mouse_motion_y(ev->motion.yrel);
+        }
+        break;
+    case SDL_EVENT_WINDOW_FOCUS_GAINED:
+        if (sdl_window && !psx_host_mouse_capture) {
+            (void)SDL_SetWindowRelativeMouseMode(sdl_window, true);
+            psx_host_mouse_capture = 1;
+        }
+        break;
+    case SDL_EVENT_WINDOW_FOCUS_LOST:
+        if (sdl_window && psx_host_mouse_capture) {
+            (void)SDL_SetWindowRelativeMouseMode(sdl_window, false);
+            psx_host_mouse_capture = 0;
+        }
+        break;
+    default:
+        break;
+    }
+#else
+    switch (ev->type) {
+    case SDL_MOUSEWHEEL:
+        psx_keybinds_mouse_wheel(ev->wheel.y);
+        break;
+    case SDL_MOUSEMOTION:
+        if (psx_host_mouse_capture) {
+            psx_keybinds_mouse_motion((float)ev->motion.xrel);
+            psx_keybinds_mouse_motion_y((float)ev->motion.yrel);
+        }
+        break;
+    case SDL_WINDOWEVENT:
+        if (ev->window.event == SDL_WINDOWEVENT_FOCUS_GAINED && !psx_host_mouse_capture) {
+            SDL_SetRelativeMouseMode(SDL_TRUE);
+            psx_host_mouse_capture = 1;
+        } else if (ev->window.event == SDL_WINDOWEVENT_FOCUS_LOST && psx_host_mouse_capture) {
+            SDL_SetRelativeMouseMode(SDL_FALSE);
+            psx_host_mouse_capture = 0;
+        }
+        break;
+    default:
+        break;
+    }
+#endif
+    return true;
+}
